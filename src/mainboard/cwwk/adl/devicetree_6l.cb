chip soc/intel/alderlake

	register "pmc_gpe0_dw0" = "GPP_B"
	register "pmc_gpe0_dw1" = "GPP_D"
	register "pmc_gpe0_dw2" = "GPP_E"

	device domain 0 on
		device ref igpu on
			register "ddi_ports_config" = "{
				[DDI_PORT_A] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
				[DDI_PORT_B] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
				[DDI_PORT_1] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
			}"
		end
		device ref crashlog	off end

		device ref tcss_xhci on
			register "tcss_ports" = "{
				[0] = TCSS_PORT_DEFAULT(OC_SKIP),
				[1] = TCSS_PORT_DEFAULT(OC_SKIP),
			}"
			chip drivers/usb/acpi
				device ref tcss_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""USB3 Type-C""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref tcss_usb3_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB3 Type-A""
						register "type" = "UPC_TYPE_USB3_A"
						device ref tcss_usb3_port2 on end
					end
				end
			end
		end

		device ref xhci on
			# Positions are as seen from the front of the chassis. The
			# Type-C and the USB3 Type-A are single ports; only the four
			# USB2 Type-A ports are stacked, in a middle and a right pair.
			#
			# The internal F_USB1 header carries two more USB2 ports,
			# which are not listed here because their port numbers are
			# unknown. The vendor firmware leaves all twelve enabled and
			# writes nothing to USB2PDO, and its ACPI has no _UPC, so
			# nothing in software identifies them.
			register "usb2_ports" = "{
				[0] = USB2_PORT_TYPE_C(OC_SKIP),	/* Type-C */
				[2] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, right lower */
				[3] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, middle lower */
				[4] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A SuperSpeed */
				[5] = USB2_PORT_SHORT(OC_SKIP),		/* microSD card reader */
				[6] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, right upper */
				[7] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, middle upper */
			}"
			chip drivers/usb/acpi
				device ref xhci_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-C""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-A Right Lower""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port3 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-A Middle Lower""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port4 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-A SuperSpeed""
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb2_port5 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""microSD Card Reader""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port6 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-A Right Upper""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port7 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-A Middle Upper""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port8 on end
					end
				end
			end
		end

		device ref shared_sram	on end
		# GPP_H4 and GPP_H5 are in I2C0 native mode under the vendor
		# firmware, so the bus is routed somewhere on the board. What
		# sits on it is not known.
		device ref i2c0		on end
		device ref heci1	on end
		device ref sata		on end

		device ref pcie_rp1 on	# i226-V, ETH0
			register "pch_pcie_rp[PCH_RP(1)]" = "{
				.clk_src = 0,
				.clk_req = 0,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 0 "ETH0"
			end
		end

		device ref pcie_rp2 on	# i226-V, ETH1
			register "pch_pcie_rp[PCH_RP(2)]" = "{
				.clk_src = 1,
				.clk_req = 1,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 1 "ETH1"
			end
		end

		device ref pcie_rp3 on	# i226-V, ETH2
			register "pch_pcie_rp[PCH_RP(3)]" = "{
				.clk_src = 2,
				.clk_req = 2,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 2 "ETH2"
			end
		end

		device ref pcie_rp4 on	# i226-V, ETH3
			register "pch_pcie_rp[PCH_RP(4)]" = "{
				.clk_src = 3,
				.clk_req = 3,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 3 "ETH3"
			end
		end

		device ref pcie_rp7 on	# i226-V, ETH4
			register "pch_pcie_rp[PCH_RP(7)]" = "{
				.clk_src = 4,
				.clk_req = 4,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 4 "ETH4"
			end
		end

		device ref pcie_rp9 on	# M.2 2280 M key, silkscreened NVME TC M.2 WIFI
			register "pch_pcie_rp[PCH_RP(9)]" = "{
				.clk_src = 5,
				.clk_req = 5,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT,
			}"
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280 (M2_NVME1)" "SlotDataBusWidth1X"
		end

		# SRCCLKREQ6# is the one clock request the board does not route, so
		# this port runs its clock free. It carries the boot drive, which is
		# the least harmful place for an always-on clock.
		device ref pcie_rp10 on	# M.2 2280 M key, silkscreened M2_NVME2
			register "pch_pcie_rp[PCH_RP(10)]" = "{
				.clk_src = 6,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_UNUSED,
			}"
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280 (M2_NVME2)" "SlotDataBusWidth1X"
		end

		device ref pcie_rp11 on	# i226-V, ETH5
			register "pch_pcie_rp[PCH_RP(11)]" = "{
				.clk_src = 7,
				.clk_req = 7,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 5 "ETH5"
			end
		end

		device ref pch_espi on
			register "gen1_dec" = "LPC_IO(0x200, 0x100)"
			register "gen2_dec" = "LPC_IO(0xa00, 0x40)"
			register "gen3_dec" = "LPC_IO(0x80, 0x10)"
			chip superio/ite/it8613e
				register "ec.vin_mask" = "VIN_ALL"

				# The CPU temperature arrives over PECI and the vendor
				# routes it to TMPIN1. TMPIN2 and TMPIN3 are unpopulated.
				register "TMPIN1.mode" = "THERMAL_PECI"
				register "TMPIN2.mode" = "THERMAL_MODE_DISABLED"
				register "TMPIN3.mode" = "THERMAL_MODE_DISABLED"

				# The chassis is fanless as shipped. FAN2 is the only
				# populated header, and its tachometer is the only one
				# that responds.
				register "FAN1.mode"		= "FAN_MODE_OFF"
				# Curve values are the vendor's own, read from the
				# Smart Fan Function menu of CWWK's firmware for
				# the CW-S7 Pro-X550-20G, a sibling board in this
				# family. tmp_delta is not exposed there; 3C is a
				# conservative hysteresis to stop the fan hunting.
				#
				# Unlike the sibling board, TMPIN1 here is the CPU
				# temperature over PECI rather than a board diode,
				# so the same thresholds act on a reading that runs
				# roughly 10C hotter. That makes the fan respond to
				# CPU load, which suits a chassis that is otherwise
				# passively cooled.
				register "FAN2.mode"		= "FAN_SMART_AUTOMATIC"
				register "FAN2.smart.tmpin"	= "1"
				register "FAN2.smart.tmp_off"	= "35"
				register "FAN2.smart.tmp_start"	= "45"
				register "FAN2.smart.tmp_full"	= "90"
				register "FAN2.smart.tmp_delta"	= "3"
				register "FAN2.smart.pwm_start"	= "35"
				register "FAN2.smart.slope"	= "15"
				register "FAN3.mode"		= "FAN_MODE_OFF"

				device pnp 2e.1 on	# COM1
					io 0x60 = 0x3f8
					irq 0x70 = 0x4
					irq 0xf0 = 0x1
				end
				device pnp 2e.4 on	# Environment controller
					io 0x60 = 0x0a30
					io 0x62 = 0x0a20
					irq 0x70 = 0x00
					irq 0x71 = 0x80
				end
				device pnp 2e.5 off end	# PS/2 keyboard
				device pnp 2e.6 off end	# PS/2 mouse
				device pnp 2e.7 on	# GPIO
					io 0x60 = 0x0a10
					io 0x62 = 0x0a00
					irq 0x70 = 0x00
				end
				device pnp 2e.a off end	# Consumer IR
			end
		end

		device ref hda		on end
		device ref smbus	on end

		chip drivers/crb
			device mmio 0xfed40000 on end
		end
	end
end
