chip soc/intel/alderlake

	register "pmc_gpe0_dw0" = "GPP_B"
	register "pmc_gpe0_dw1" = "GPP_D"
	register "pmc_gpe0_dw2" = "GPP_E"

	device domain 0 on
		device ref igpu on
			register "ddi_ports_config" = "{
				[DDI_PORT_A] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
				[DDI_PORT_B] = DDI_ENABLE_HPD | DDI_ENABLE_DDC,
			}"
		end
		device ref crashlog	off end

		device ref tcss_xhci on
			register "tcss_ports" = "{
				[0] = TCSS_PORT_DEFAULT(OC_SKIP),
				[1] = TCSS_PORT_DEFAULT(OC_SKIP),
			}"
			chip drivers/usb/acpi
				device ref tcss_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""USB3 Type-A Left Lower""
						register "type" = "UPC_TYPE_USB3_A"
						device ref tcss_usb3_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB3 Type-C Left Upper""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref tcss_usb3_port2 on end
					end
				end
			end
		end

		device ref xhci on
			# Rear port positions are as seen from the rear of the chassis
			register "usb2_ports" = "{
				[0] = USB2_PORT_SHORT(OC_SKIP),		/* microSD card reader */
				[1] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A SuperSpeed, left lower */
				[2] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, right upper */
				[3] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, right lower */
				[5] = USB2_PORT_TYPE_C(OC_SKIP),	/* Type-C, left upper */
				[6] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, middle lower */
				[7] = USB2_PORT_SHORT(OC_SKIP),		/* Type-A, middle upper */
				[9] = USB2_PORT_SHORT(OC_SKIP),		/* CNVi Bluetooth */
			}"
			chip drivers/usb/acpi
				device ref xhci_root_hub on
					chip drivers/usb/acpi
						register "desc" = ""microSD Card Reader""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port1 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-A SuperSpeed Left Lower""
						register "type" = "UPC_TYPE_USB3_A"
						device ref usb2_port2 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Right Upper""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port3 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Right Lower""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port4 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Type-C Left Upper""
						register "type" = "UPC_TYPE_C_USB2_SS_SWITCH"
						device ref usb2_port6 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Middle Lower""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port7 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""USB2 Middle Upper""
						register "type" = "UPC_TYPE_A"
						device ref usb2_port8 on end
					end
					chip drivers/usb/acpi
						register "desc" = ""CNVi Bluetooth""
						register "type" = "UPC_TYPE_INTERNAL"
						device ref usb2_port10 on end
					end
				end
			end
		end

		device ref shared_sram	on end
		device ref cnvi_wifi	on end
		device ref heci1	on end
		device ref sata		on end

		device ref pcie_rp1 on	# 82599ES dual-port 10G SFP+
			register "pch_pcie_rp[PCH_RP(1)]" = "{
				.clk_src = 1,
				.clk_req = 1,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 0 "SFP+1"
			end
			device pci 00.1 on
				smbios_dev_info 1 "SFP+2"
			end
		end

		device ref pcie_rp7 on	# i226-V, ETH0
			register "pch_pcie_rp[PCH_RP(7)]" = "{
				.clk_src = 2,
				.clk_req = 2,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 2 "ETH0"
			end
		end

		device ref pcie_rp9 on	# i226-V, ETH1
			register "pch_pcie_rp[PCH_RP(9)]" = "{
				.clk_src = 3,
				.clk_req = 3,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT | PCIE_RP_BUILT_IN,
				.pcie_rp_aspm = ASPM_L0S,
			}"
			device pci 00.0 on
				smbios_dev_info 3 "ETH1"
			end
		end

		device ref pcie_rp10 on	# M.2 E key, PCIe and CNVi
			register "pch_pcie_rp[PCH_RP(10)]" = "{
				.clk_src = 0,
				.clk_req = 0,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT,
			}"
			smbios_slot_desc "SlotTypeM2Socket1_SD" "SlotLengthOther" "M.2/E 2230 (CNVi WiFi)" "SlotDataBusWidth1X"
		end

		device ref pcie_rp12 on	# M.2 M key 2280
			register "pch_pcie_rp[PCH_RP(12)]" = "{
				.clk_src = 4,
				.clk_req = 4,
				.flags = PCIE_RP_AER | PCIE_RP_CLK_REQ_DETECT,
			}"
			smbios_slot_desc "SlotTypeM2Socket3" "SlotLengthOther" "M.2/M 2280 (NVMe)" "SlotDataBusWidth1X"
		end

		device ref pch_espi on
			register "gen1_dec" = "LPC_IO(0x200, 0x100)"
			register "gen2_dec" = "LPC_IO(0xa00, 0x40)"
			register "gen3_dec" = "LPC_IO(0x80, 0x10)"
			chip superio/ite/it8625e
				register "ec.vin_mask" = "VIN_ALL"
				register "TMPIN1.mode" = "THERMAL_DIODE"
				register "TMPIN2.mode" = "THERMAL_DIODE"
				register "TMPIN3.mode" = "THERMAL_MODE_DISABLED"

				# Curve values are the vendor's own, read from the
				# Smart Fan Function menu of CWWK's firmware for
				# the CW-S7 Pro-X550-20G, a sibling board in this
				# family. tmp_delta is not exposed there; 3C is a
				# conservative hysteresis to stop the fan hunting.
				register "FAN1.mode"		= "FAN_SMART_AUTOMATIC"
				register "FAN1.smart.tmpin"	= "1"
				register "FAN1.smart.tmp_off"	= "35"
				register "FAN1.smart.tmp_start"	= "45"
				register "FAN1.smart.tmp_full"	= "90"
				register "FAN1.smart.tmp_delta"	= "3"
				register "FAN1.smart.pwm_start"	= "35"
				register "FAN1.smart.slope"	= "15"
				register "FAN2.mode"		= "FAN_MODE_OFF"
				register "FAN3.mode"		= "FAN_MODE_OFF"

				device pnp 2e.1 on	# COM1
					io 0x60 = 0x3f8
					irq 0x70 = 0x4
					irq 0xf0 = 0x1
				end
				device pnp 2e.2 on	# COM2
					io 0x60 = 0x2f8
					irq 0x70 = 0x3
					irq 0xf0 = 0x1
				end
				device pnp 2e.3 off end	# Parallel port
				device pnp 2e.4 on	# Environment controller
					io 0x60 = 0x0a20
					io 0x62 = 0x0a10
					# No ISA IRQ; the HWM defaults to the ACPI SCI
					irq 0x70 = 0x00
				end
				device pnp 2e.5 off end	# PS/2 keyboard
				device pnp 2e.6 off end	# PS/2 mouse
				device pnp 2e.7 on	# GPIO
					io 0x62 = 0x0a00
					irq 0x70 = 0x00
				end
				device pnp 2e.a off end	# Consumer IR
			end
		end

		device ref hda		on end
		device ref smbus	on end

		chip drivers/crb
			device mmio 0xfed40000 on end
		end
	end
end
